# 預設自動正規化文字檔換行符
* text=auto

# ==================================================
# Shell 腳本：必須 LF
# （在 macOS / Linux / Windows+WSL 由 bash 執行，
#   若含 CRLF 會出現 "/bin/bash^M: bad interpreter" 而整個 hook 失效）
# ==================================================
*.sh   text eol=lf

# ==================================================
# Windows 專用腳本：CRLF
# ==================================================
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# ==================================================
# 二進位檔（不做換行符轉換）
# ==================================================
*.exe  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.zst  binary
*.db   binary
