{
  "version": 1,
  "_note": "RTK hook template for VS Code Copilot and GitHub Copilot CLI.",
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash|run_in_terminal|runTerminalCommand",
        "bash": "bash .agents/skills/rtk-token-killer/scripts/rtk-hook-wrapper.sh",
        "powershell": "pwsh -NoProfile -NonInteractive -File .\\.agents\\skills\\rtk-token-killer\\scripts\\rtk-hook-wrapper.ps1",
        "osx": "bash .agents/skills/rtk-token-killer/scripts/rtk-hook-wrapper.sh",
        "linux": "bash .agents/skills/rtk-token-killer/scripts/rtk-hook-wrapper.sh",
        "windows": "pwsh -NoProfile -NonInteractive -File .\\.agents\\skills\\rtk-token-killer\\scripts\\rtk-hook-wrapper.ps1",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "bash .agents/skills/rtk-token-killer/scripts/rtk-hook-wrapper.sh",
        "powershell": "pwsh -NoProfile -NonInteractive -File .\\.agents\\skills\\rtk-token-killer\\scripts\\rtk-hook-wrapper.ps1",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
